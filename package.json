{
  "name": "irodr",
  "version": "2.0.0",
  "private": true,
  "description": "LDR-like keyboard-driven reader for Inoreader and GitHub Notifications",
  "homepage": "https://irodr.netlify.app",
  "license": "MIT",
  "author": "azu",
  "repository": {
    "type": "git",
    "url": "https://github.com/azu/irodr"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test",
    "test:e2e": "vp build --mode e2e --outDir dist-e2e && playwright test",
    "build:local": "vp build && vp pack",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@stylexjs/stylex": "catalog:",
    "markdown-it": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@irodr/oxlint-plugin-immutable": "workspace:*",
    "@playwright/test": "catalog:",
    "@stylexjs/eslint-plugin": "catalog:",
    "@stylexjs/unplugin": "catalog:",
    "@types/markdown-it": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint-plugin-baseline-js": "catalog:",
    "oxc-transform-react": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.34.5"
}
