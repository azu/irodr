{
  "name": "irodr",
  "version": "2.0.0",
  "private": true,
  "description": "LDR-like keyboard-driven reader for Inoreader and GitHub Notifications",
  "homepage": "https://irodr.netlify.app",
  "license": "MIT",
  "author": "azu",
  "repository": {
    "type": "git",
    "url": "https://github.com/azu/irodr"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test",
    "test:e2e": "vp build --mode e2e --outDir dist-e2e && playwright test",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.1",
    "markdown-it": "^15.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@irodr/oxlint-plugin-immutable": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@stylexjs/eslint-plugin": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "vite-plus": "1.0.0-rc.0"
  },
  "packageManager": "pnpm@10.34.5"
}
